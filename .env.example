# Public URL your tunnel serves (used for links in LINE messages).
# For localhost testing: http://localhost:8000
BASE_URL=https://ielts.example.com

# LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Grading model (default claude-sonnet-5-5; claude-opus-5-5 is stronger but about 2x the price)
# CLAUDE_MODEL=claude-sonnet-5-5

# Web login password (also used for the LINE "綁定" command)
WEB_PASSWORD=
# A long random string: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
